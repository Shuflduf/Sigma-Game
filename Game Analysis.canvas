		{"id":"85d3c1a056c77c2c","type":"text","text":"Allows the player to observe and appreciate the environment in their own time","x":-1809,"y":-928,"width":297,"height":99},
		{"id":"fdbd0397c4daa993","type":"text","text":"Short","x":-1872,"y":-634,"width":250,"height":60},
		{"id":"f787225f186c2753","type":"text","text":"Around 2 to 3 times longer","x":-1817,"y":-532,"width":250,"height":60},
		{"id":"938044667457ccf3","type":"text","text":"Longest round, around twice as long as Round 2","x":-1813,"y":-448,"width":250,"height":60},
		{"id":"ff9b2976497d19b5","type":"text","text":"No Rush to Start","x":-2146,"y":-909,"width":250,"height":60},
