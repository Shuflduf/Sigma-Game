		{"id":"c5012cc64970505d","type":"text","text":"Shot: Pulls back into darkness, no actual sign of damage, Hands come out from darkness first and pull him back into frame","x":2844,"y":-1409,"width":394,"height":85},
		{"id":"c7ec8445ce8efb78","type":"text","text":"Lost last round: Pulls back into darkness, eyes turn red, out comes a briefcase of money","x":2845,"y":-1218,"width":349,"height":88},
