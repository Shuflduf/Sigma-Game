		{"id":"32d959389c1eee94","type":"text","text":"Enemy pauses for a second in between selecting items","x":-1327,"y":-1092,"width":250,"height":60},
		{"id":"6b538153ac3a1f2b","type":"text","text":"Gives illusion of thinking","x":-1683,"y":-1088,"width":250,"height":60},
		{"id":"8947c6ce24b9c105","type":"text","text":"Doesn't Kill Immersion","x":-3739,"y":-395,"width":250,"height":60},
		{"id":"a493bff52d79e6ff","type":"text","text":"Win: Enemy health reaches 0","x":836,"y":-471,"width":250,"height":60},
