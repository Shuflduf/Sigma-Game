		{"id":"a13e99b9bf8b6a79","type":"text","text":"If down to last 2 lives, No more healing","x":-2490,"y":-323,"width":250,"height":60},
		{"id":"a26c44379a7561be","type":"text","text":"The start music, General Release, is around the same bpm as a fast beating heart","x":-1555,"y":-788,"width":326,"height":91},
