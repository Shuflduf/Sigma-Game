		{"id":"ee708071f8df46fc","type":"text","text":"Magnifying Glass: Breaks it against table, looks through the glass shard, says \"very interesting...\"","x":3599,"y":-1712,"width":399,"height":69},
		{"id":"f9ee4a3e36d7ef61","type":"text","text":"Burner Phone: Listens for a seconds then throws the phone away","x":3596,"y":-1632,"width":275,"height":85},
		{"id":"bc5ceeb0fbeaba15","type":"text","text":"Adrenaline: Not really used, just thrown away","x":3594,"y":-1534,"width":250,"height":60},
