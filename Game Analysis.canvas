		{"id":"d2e0aa1561ec8da5","type":"text","text":"Blanks and lives are no longer stated, and are in a random order","x":-2689,"y":-500,"width":326,"height":64},
		{"id":"82de32d2ba0a6f66","type":"text","text":"We now have to manually count them","x":-3019,"y":-492,"width":250,"height":60},
