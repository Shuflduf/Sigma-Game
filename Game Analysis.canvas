		{"id":"3f4f3cc46297973c","type":"text","text":"Only played using Mouse","x":-1649,"y":210,"width":250,"height":60},
		{"id":"4d0b5f12c0a230bd","type":"text","text":"No complex interaction","x":-2500,"y":221,"width":250,"height":60},
		{"id":"e90d9cff0d7a77ee","type":"text","text":"Takes away our clutch/safety","x":-2146,"y":-347,"width":250,"height":60},
