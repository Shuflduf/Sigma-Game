		{"id":"3642116762148c06","type":"text","text":"Score, and other relevant information","x":-2599,"y":441,"width":250,"height":60},
		{"id":"c8a7160dfea96957","type":"text","text":"\"Dealer\", and \"You\" is visualized on the Table","x":-1814,"y":645,"width":250,"height":60},
		{"id":"902116f4855919eb","type":"text","text":"Gun Selected","x":-1371,"y":610,"width":154,"height":60},
		{"id":"316a9f41101e9544","type":"text","text":"Non-intrusive, makes the UI feel part of the world","x":-2183,"y":658,"width":250,"height":60},
